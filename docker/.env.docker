# ─────────────────────────────────────────────────────────────────
# Configuration de l'API quand elle tourne dans Docker.
# Copiée en .env par docker/entrypoint.sh au démarrage du conteneur.
#
# Pourquoi un fichier et pas des variables "environment:" dans
# docker-compose.yml ? Parce que "php artisan serve" ne transmet PAS
# ces variables au serveur PHP qui répond aux requêtes : l'API
# retombait sur SQLite au lieu de MySQL. Un fichier .env, lui,
# est toujours lu.
#
# Identifiants de DÉMONSTRATION uniquement, jamais en production.
# ─────────────────────────────────────────────────────────────────

APP_NAME="Task Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# "db" = le nom du service MySQL dans docker-compose.yml.
# Entre conteneurs, on utilise le port INTERNE 3306 (pas 3307).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=task_manager
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
